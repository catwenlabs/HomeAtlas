# Required: password for the PostgreSQL homeatlas user (used by both containers).
POSTGRES_PASSWORD=change-me

# Required in production: JWT signing key (at least 32 random bytes).
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Optional overrides
APP_ENV=development
LOG_LEVEL=info

# Host bind for the API port. Default 127.0.0.1:8000 (local only).
# For LAN access use your machine's LAN IP, e.g. 192.168.1.10:8000. Never expose publicly.
# API_BIND=127.0.0.1:8000

# Host bind for the web UI. Default 127.0.0.1:8080 (local only).
# WEB_BIND=127.0.0.1:8080

# Access token lifetime in minutes (default 7 days).
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CSV import (Phase 2B-1). The directory is local to the API container.
# IMPORT_STORAGE_DIR=/tmp/homeatlas-imports
# IMPORT_MAX_FILE_MB=10
# IMPORT_MAX_ROWS=20000

# ---- Market quotes (2C-2) ----
# tencent (default, no API key) | fake (offline, for tests)
QUOTE_PROVIDER=tencent
# QUOTE_TIMEOUT_SECONDS=5.0
# QUOTE_CACHE_TTL_SECONDS=30.0
# Optional HTTP proxy for reaching US quotes from mainland networks
# QUOTE_PROXY_URL=http://127.0.0.1:7890
